<Window x:Class="Ostraplan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ostraplan.App"
        Title="Ostraplan" Width="1440" Height="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        TextElement.Foreground="{DynamicResource Ink}">
    <Window.Resources>
        <Style x:Key="SideHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <!-- The PART name, edited in place (issue #30). The game's own object panel lets you type over a name
             where it is shown rather than through a menu, so this reads as a plain line until it takes focus and
             wears the theme's own text-box chrome once it does. Two details worth keeping:
             * The flattening lives in TRIGGERS on the unfocused and read-only states, never in setters. That way
               the focused look is Fluent's own rather than something hand-drawn its states would paint over
               (CONVENTIONS.md), and hovering a live field brings the box back as the affordance that it is one.
             * Padding and the negative Margin cancel out (the Fluent template adds ~3px of its own), so the text
               sits in the same column as every other row and the line does not jump when focus arrives. -->
        <Style x:Key="InlineName" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Margin" Value="-7,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                        <Condition Property="IsMouseOver" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SideValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Uniform small buttons for the Zones panel (Add / Properties / delete) -->
        <!-- Compact: it sits on a header row in a narrow panel, so it sizes to its label rather than to the row. -->
        <Style x:Key="ZoneBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Toolbar group separator -->
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="7,3"/>
            <Setter Property="Background" Value="{DynamicResource PanelBorder}"/>
        </Style>
        <!-- Toolbar overlay toggle (Zones / Rooms / Power / Light / Wire). A ToggleButton based on the Fluent theme
             style, so inactive it matches the other toolbar buttons exactly and active it wears the theme's own
             checked accent — theme-aware with correct contrast in every state (hover/pressed, light/dark). The
             IsChecked state is driven from the live overlay flags in MainWindow.SyncViewToggles. -->
        <Style x:Key="OverlayToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>
        <!-- Menu text was hard to read: nothing in the app styled a menu at all, so items wore whatever the
             Fluent default resolved to over our own panel background. BasedOn keeps the control on the Fluent
             chain (CONVENTIONS: an explicit style with no BasedOn drops out of the theme and back to the light
             Aero2 template), and only the two properties that decide legibility are set on top. Ink is the same
             brush the rest of the chrome reads with, so it re-resolves on a light/dark switch. -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- The left half of a split button: the same overlay toggle with its right margin closed up, so the arrow
             that follows reads as part of the same control rather than as the next button along. -->
        <Style x:Key="SplitToggle" TargetType="ToggleButton" BasedOn="{StaticResource OverlayToggle}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- The right half: the arrow that opens that toggle's own options. Deliberately a plain Button on the
             Fluent chain rather than anything custom — CONVENTIONS is explicit that a control style adding more
             than padding and margin drops out of the theme and back to the light Aero2 template. Narrow padding
             is what makes it read as an appendage; it is not a second button. -->
        <Style x:Key="SplitArrow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="1,0,3,0"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <!-- A document tab. Same reasoning as OverlayToggle above: a ToggleButton on the Fluent chain wearing the
             theme's own checked accent for the active tab, rather than a hard-set background that Fluent's hover
             state would then paint over. IsChecked is driven from the active session in MainWindow.RefreshDocTabs. -->
        <Style x:Key="DocTab" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,3,4"/>
            <Setter Property="MaxWidth" Value="240"/>
        </Style>
        <DataTemplate x:Key="PartTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="#33808080" CornerRadius="3">
                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="3"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Friendly}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Favorite toggle. PreviewMouseLeftButtonDown handles it and marks the event handled, so clicking
                     the star pins/unpins without also arming the row's brush. -->
                <TextBlock Grid.Column="2" Text="{Binding FavGlyph}" FontSize="15" Cursor="Hand"
                           VerticalAlignment="Center" Margin="4,0,2,0"
                           PreviewMouseLeftButtonDown="OnFavStarClick"
                           ToolTip="Pin to Favorites">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                            <Setter Property="Opacity" Value="0.4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Foreground" Value="#FFF2B01E"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Chrome = everything the user can edit with (toolbar, sidebar, canvas). MainWindow.FreezeDoc disables it as
         one switch while an engine reads the live document off-thread; naming it is what makes that possible. -->
    <DockPanel x:Name="Chrome">
        <!-- The ribbon is ONE row that becomes two only when it has to (#49).
             At the default window size a single row could not hold the actions, the eight overlay toggles and the
             ship's name, and it was the NAME that lost: the fixed-size buttons took their width first and the
             centre was left with none, so a design opened with no title showing. A permanent second row fixes that
             and costs a strip of vertical space on every wide window, where everything fitted anyway. So the
             toggles move between row 0 and row 1 on width, in RelayoutRibbon.

             Four columns rather than three so the switch is two attached properties and no reparenting: the
             toggles sit in their own Auto column when they are on row 0, and that column collapses to nothing
             when they drop to row 1. The identity block spans both rows so its byline is centred under its name
             whichever arrangement is live. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" Padding="8,6">
            <Grid x:Name="RibbonGrid" SizeChanged="OnRibbonSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- The actions. Always row 0, always leftmost. -->
                <StackPanel x:Name="RibbonActions" Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnFileMenu" Content="File ▾" Padding="10,3" Margin="0,0,3,0" Click="OnFileMenuClick"
                            ToolTip="New, open, save, import, export, and write back to a save."/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <!-- Edit (frequent — kept as direct buttons) -->
                    <Button x:Name="BtnUndo" Content="Undo" Padding="10,3" Margin="0,0,3,0" Click="OnUndoClick"
                            ToolTip="Undo the last edit. (Ctrl+Z)"/>
                    <Button x:Name="BtnRedo" Content="Redo" Padding="10,3" Margin="0,0,3,0" Click="OnRedoClick"
                            ToolTip="Redo the last undone edit. (Ctrl+Y)"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <Button x:Name="BtnDesignMenu" Content="Design ▾" Padding="10,3" Margin="0,0,3,0" Click="OnDesignMenuClick"
                            ToolTip="Ship identity, re-skin, repairs, snapshot, bill of materials, and reports."/>

                    <Button x:Name="BtnSimulateMenu" Content="Simulate ▾" Padding="10,3" Margin="0,0,3,0" Click="OnSimulateMenuClick"
                            ToolTip="Fire a micrometeoroid or weapon at the design and see what breaks."/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <!-- Analyse (headline action — kept prominent) -->
                    <Button x:Name="BtnRating" Content="Ship Rating" Padding="10,3" Margin="0,0,3,0" Click="OnShipRatingClick"
                            Background="{DynamicResource AccentBg}" Foreground="{DynamicResource AccentText}"
                            ToolTip="Score the design: rooms, airtightness, certification and the game's Ship Rating."/>
                    <Button x:Name="BtnDiagnostics" Content="Diagnostics" Padding="10,3" Margin="0,0,3,0" Click="OnDiagnosticsClick"
                            ToolTip="The game's nav-console checklist: power, thrusters, antenna and life support."/>
                </StackPanel>

                <!-- Row 2, grouped by WHAT A BUTTON DOES rather than by where its options used to live (#50).
                     Two clusters, and the separator between them is the whole point of the grouping:

                       * EDIT MODES change what a click does. Symmetry mirrors what you place; Surfaces ghosts
                         everything but walls and floors AND re-points a click at the deck under the clutter
                         (ShipCanvas.SurfaceAwareHit). Neither is a view, and both sat among the overlays for
                         years being described as things that "only change what you see".
                       * OVERLAYS draw something extra and change nothing about editing.

                     A button with options carries its own, on a ▾ beside it, instead of them living in a View menu
                     across the ribbon from the button they belong to. That menu is now gone: every one of its
                     items had a natural owner, and Fit to ship was a one-shot camera command filed among
                     persistent settings, so it is a button. Overlay order is otherwise unchanged, so anything
                     already in the fingers still is.

                     Row and column are set by RelayoutRibbon; the values here are only the wide arrangement it
                     starts in. The keyboard gestures still drive all of these; SyncViewToggles keeps IsChecked in
                     step whichever path fires. Click drives the canvas; the code-set IsChecked never re-enters
                     Click. -->
                <StackPanel x:Name="RibbonToggles" Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <Border x:Name="RibbonTogglesSep" Style="{StaticResource ToolSep}"/>

                    <!-- Edit modes. -->
                    <ToggleButton x:Name="BtnSymmetry" Content="Symmetry" Style="{StaticResource OverlayToggle}" Click="OnSymmetryToggleClick"
                            ToolTip="Mirror what you place. Click to cycle the axes, drag the handle to move them. (M)"/>
                    <ToggleButton x:Name="BtnSurface" Content="Surfaces" Style="{StaticResource OverlayToggle}" Click="OnSurfaceToggleClick"
                            ToolTip="Ghost all but walls and floors, and paint skins onto the deck. (T)"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <!-- Overlays. -->
                    <ToggleButton x:Name="BtnZones" Content="Zones" Style="{StaticResource OverlayToggle}" Click="OnZonesToggleClick"
                            ToolTip="Show the crew-assignable zone paint. (Z)"/>
                    <ToggleButton x:Name="BtnRooms" Content="Rooms" Style="{StaticResource OverlayToggle}" Click="OnRoomsToggleClick"
                            ToolTip="Show the compartments the game would flood-fill. (C)"/>
                    <ToggleButton x:Name="BtnPower" Content="Power" Style="{StaticResource OverlayToggle}" Click="OnPowerToggleClick"
                            ToolTip="Show the conduit network and any orphaned runs. (P)"/>
                    <ToggleButton x:Name="BtnLight" Content="Light" Style="{StaticResource SplitToggle}" Click="OnLightToggleClick"
                            ToolTip="Simulate the in-game interior lighting. (L)"/>
                    <Button x:Name="BtnLightMenu" Content="▾" Style="{StaticResource SplitArrow}" Click="OnLightMenuClick"
                            ToolTip="Exterior sun and its angle."/>
                    <ToggleButton x:Name="BtnWalk" Content="Walk" Style="{StaticResource SplitToggle}" Click="OnWalkToggleClick"
                            ToolTip="Show which tiles crew can reach and which fittings they can use. (K)"/>
                    <Button x:Name="BtnWalkMenu" Content="▾" Style="{StaticResource SplitArrow}" Click="OnWalkMenuClick"
                            ToolTip="Whether EVA access counts, and whether Forbid zones are respected."/>
                    <ToggleButton x:Name="BtnAccess" Content="Access" Style="{StaticResource OverlayToggle}" Click="OnAccessToggleClick"
                            ToolTip="Point at a fitting to see where crew would work it from. (J)"/>
                    <ToggleButton x:Name="BtnWire" Content="Wire" Style="{StaticResource OverlayToggle}" Click="OnWireToggleClick"
                            ToolTip="Show signal wiring: sensors a device follows, and boxes that switch it."/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <!-- Camera. Nothing to configure, so no arrow. -->
                    <Button x:Name="BtnFit" Content="Fit" Padding="10,3" Margin="0,0,3,0" Click="OnFitClick"
                            ToolTip="Frame the whole design in the view. (F)"/>
                </StackPanel>


                <!-- The design's identity, spanning both rows so the byline sits directly under the name in either
                     arrangement. Both strings are as long as the data makes them, so both trim rather than push
                     the column open (CONVENTIONS: a wrapping TextBlock sets the width, not the other way round). -->
                <StackPanel x:Name="RibbonIdentity" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,0">
                    <TextBlock x:Name="TxtDoc" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtDocByline" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Dim}" FontSize="11" Margin="0,1,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Right side. Always row 0. -->
                <StackPanel x:Name="RibbonRight" Grid.Row="0" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtWarnings" VerticalAlignment="Center"
                               Foreground="{DynamicResource Warn}" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtVersion" VerticalAlignment="Center"
                               Foreground="{DynamicResource Dim}" Margin="12,0,0,0"/>
                    <Button x:Name="BtnUpdate" Padding="10,3" Margin="6,0,0,0"
                            Visibility="Collapsed" Click="OnUpdateClick"
                            Background="{DynamicResource AccentBg}" Foreground="{DynamicResource AccentText}"
                            ToolTip="A newer release is available — click to open the download page"/>
                    <Button x:Name="BtnSettings" Content="⚙ Settings" Padding="10,3" Margin="6,0,0,0"
                            Click="OnSettingsClick"
                            ToolTip="Theme, UI scale, mod overrides, and the game folders. (Ctrl+,)"/>
                    <Button x:Name="BtnHelp" Content="Help ▾" Padding="10,3" Margin="6,0,0,0"
                            Click="OnHelpMenuClick" ToolTip="Controls and keybinds, report a bug, and the activity log. (F1)"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Dim}">
            <StatusBarItem><TextBlock x:Name="TxtCell" Text="—" Width="110"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtSel" Text="" Width="90"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtZoom" Text="" Width="90"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtBrush" Text="" Width="80"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtParts" Text=""/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtGhost" Text="" FontWeight="SemiBold" Foreground="{DynamicResource Bad}"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtHint" Opacity="0.7"
                           Text="drag paint · Shift+drag fill · Ctrl+Shift hollow · RMB menu · R rotate · Q/E view · WASD pan · F1 help"/>
            </StatusBarItem>
        </StatusBar>

        <!-- The workspace: palette, canvas, inspector, with a draggable splitter between each pair. It was a
             DockPanel with two fixed-width Borders, so a part name longer than 330px was simply truncated and
             there was nothing the user could do about it. Widths persist in AppSettings, and either pane
             collapses to nothing (double-click its splitter, F2 / F3) to give the canvas the whole window.

             MinWidth on the centre column, not on the panes: the panes have to reach zero to collapse, and it is
             the CANVAS that must never be squeezed out of existence. -->
        <Grid x:Name="Workspace">
            <Grid.ColumnDefinitions>
                <!-- MinWidth on the two panes is set from code (RestorePaneWidths / ApplyPaneWidth), not here: it
                     has to come off to collapse a pane, since a column cannot be driven below its own minimum. -->
                <ColumnDefinition x:Name="ColPalette" Width="330"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="ColInspector" Width="270"/>
            </Grid.ColumnDefinitions>

        <Border x:Name="PalettePane" Grid.Column="0" Background="{DynamicResource PanelBg}" Padding="8"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBox x:Name="TxtSearch" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="4,3"
                         TextChanged="OnSearchChanged" ToolTip="Search parts by name"/>
                <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"/>
            </DockPanel>
        </Border>

            <GridSplitter x:Name="SplitPalette" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False"
                          DragCompleted="OnSplitterDragCompleted" MouseDoubleClick="OnPaletteSplitterDoubleClick"
                          ToolTip="Drag to resize the palette. Double-click to hide it. (F2)"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- The document tab strip. Auto, and collapsed while one design is open, so a single-document
                     session looks exactly as it did before tabs existed. -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="DocTabBar" Grid.Row="0" Visibility="Collapsed" Padding="6,4,6,0"
                    Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DocTabStrip" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Every open design's canvas lives here at once. The active one is Visible and the rest Hidden, not
                 Collapsed: Hidden is still measured and arranged, so a background tab keeps a real size and its
                 zoom, pan and framing stay meaningful, while WPF skips drawing it entirely. -->
            <Grid x:Name="CanvasHost" Grid.Row="1"/>

            <!-- The Surfaces bar: the two brushes a pattern alternates between, and the pattern itself. Shown only
                 while Surfaces mode is on (MainWindow.UpdateSurfaceBar drives every part of it). Slot A is the armed
                 palette brush; slot B is picked by arming the slot, then clicking a palette part. -->
            <Border x:Name="SurfaceBar" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="14,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SURFACES" Foreground="{DynamicResource Dim}" FontSize="11" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton x:Name="SlotA" Padding="6,3" Margin="0,0,4,0" Click="OnSurfaceSlotClick"
                                      ToolTip="The main brush — arm it from the palette">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgSlotA" Width="22" Height="22" Stretch="Uniform" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="TxtSlotA" Text="A: none" VerticalAlignment="Center" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="SlotB" Padding="6,3" Margin="0,0,4,0" Click="OnSurfaceSlotClick"
                                      ToolTip="The second brush of a pattern — click this, then pick a matching wall or floor from the palette">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgSlotB" Width="22" Height="22" Stretch="Uniform" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="TxtSlotB" Text="B: none" VerticalAlignment="Center" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="BtnClearSlotB" Content="✕" Padding="7,3" Click="OnClearSlotBClick"
                                ToolTip="Clear the second brush"/>
                    </StackPanel>
                    <StackPanel x:Name="PatternRow" Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton x:Name="PatSolid" Content="Solid" Tag="Solid" Padding="9,3" Margin="0,0,4,0"
                                      Click="OnSurfacePatternClick" ToolTip="One brush on every tile"/>
                        <ToggleButton x:Name="PatChecker" Content="Checker" Tag="Checker" Padding="9,3" Margin="0,0,4,0"
                                      Click="OnSurfacePatternClick" ToolTip="Alternate the two brushes like a chequerboard"/>
                        <ToggleButton x:Name="PatRows" Content="Rows" Tag="StripesH" Padding="9,3" Margin="0,0,4,0"
                                      Click="OnSurfacePatternClick" ToolTip="Alternate the two brushes row by row"/>
                        <ToggleButton x:Name="PatCols" Content="Columns" Tag="StripesV" Padding="9,3"
                                      Click="OnSurfacePatternClick" ToolTip="Alternate the two brushes column by column"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="SHOW" Foreground="{DynamicResource Dim}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ToggleButton x:Name="FocusBoth" Content="Both" Tag="Both" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceFocusClick" ToolTip="Walls and floors both bright"/>
                        <ToggleButton x:Name="FocusFloors" Content="Floors" Tag="Floors" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceFocusClick"
                                      ToolTip="Ghost the walls too, so the floors under them can be seen and clicked"/>
                        <ToggleButton x:Name="FocusWalls" Content="Walls" Tag="Walls" Padding="8,3" Margin="0,0,12,0"
                                      Click="OnSurfaceFocusClick" ToolTip="Ghost the floors, so a wall run reads on its own"/>
                        <TextBlock Text="PAINT" Foreground="{DynamicResource Dim}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ToggleButton x:Name="ModeReplace" Content="Replace" Tag="Replace" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceModeButtonClick"
                                      ToolTip="Only re-skin what is already there — a stroke past the edge of a room adds nothing"/>
                        <ToggleButton x:Name="ModeBoth" Content="Both" Tag="ReplaceAndFill" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceModeButtonClick" ToolTip="Re-skin what is there, and lay a new one on a bare tile"/>
                        <ToggleButton x:Name="ModeFill" Content="Fill" Tag="Fill" Padding="8,3"
                                      Click="OnSurfaceModeButtonClick" ToolTip="Only lay on bare tiles, never change what is there"/>
                    </StackPanel>
                    <!-- How visible the ghosted layers are. It lived in the View menu, then briefly on a ▾ beside
                         the Surfaces button; it belongs here, on the bar that only exists while the mode is on,
                         beside the SHOW toggles that decide WHAT is ghosted. -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="GHOST" Foreground="{DynamicResource Dim}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Slider x:Name="SldSurfaceGhost" Width="130" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                ValueChanged="OnSurfaceGhostSliderChanged"
                                ToolTip="How visible the ghosted layers are"/>
                        <TextBlock x:Name="TxtSurfaceGhost" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="38"
                                   Foreground="{DynamicResource Ink}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSurfaceNote" Foreground="{DynamicResource Dim}" FontSize="11" Margin="0,6,0,0"
                               MaxWidth="420" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0">
                <Border x:Name="BadgeWarning" Background="#F0E0A34E" CornerRadius="14" Height="28" MinWidth="28"
                        Visibility="Collapsed" Margin="8,0,0,0">
                    <TextBlock x:Name="BadgeWarningText" Foreground="#FF23262C" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0"/>
                </Border>
                <Border x:Name="BadgeBlocking" Background="#F0D64545" CornerRadius="14" Height="28" MinWidth="28"
                        Visibility="Collapsed" Margin="8,0,0,0">
                    <TextBlock x:Name="BadgeBlockingText" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0"/>
                </Border>
            </StackPanel>
            <!-- Over the tab strip as well as the canvas: while game data is loading there is nothing to switch to. -->
            <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#DD1A1C20">
                <TextBlock x:Name="TxtLoading" Text="Locating Ostranauts…" Foreground="#FFD8DDE4"
                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

            <GridSplitter x:Name="SplitInspector" Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" ShowsPreview="False"
                          DragCompleted="OnSplitterDragCompleted" MouseDoubleClick="OnInspectorSplitterDoubleClick"
                          ToolTip="Drag to resize the inspector. Double-click to hide it. (F3)"/>

        <Border x:Name="InspectorPane" Grid.Column="4" Background="{DynamicResource PanelBg}" Padding="12,8"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="PROBLEMS" Style="{StaticResource SideHeader}" Margin="0,0,0,4"/>
                <StackPanel x:Name="ProblemsPanel"/>
                <Separator Margin="0,10,0,0" Background="{DynamicResource PanelBorder}"/>
                <!-- LastChildFill MUST stay False. It defaults to True, and the button is the last child, so with
                     the default it ignores its Dock and stretches across the whole row: a "+ Add" the width of the
                     panel, jammed against the ZONES caption. -->
                <DockPanel Margin="0,10,0,2" LastChildFill="False">
                    <TextBlock Text="ZONES" DockPanel.Dock="Left" Style="{StaticResource SideHeader}"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAddZone" Content="+ Add" DockPanel.Dock="Right" Style="{StaticResource ZoneBtn}"
                            Click="OnAddZoneClick" ToolTip="Create a zone and start painting its tiles"/>
                </DockPanel>
                <StackPanel x:Name="ZonesPanel"/>
                <Separator Margin="0,10,0,0" Background="{DynamicResource PanelBorder}"/>
                <!-- Everything describing the current selection. Collapsed outright when there is none: these
                     are five headings that would otherwise sit there announcing their own emptiness, and a column
                     of labels over "—" reads as a broken panel rather than an idle one. The sub-blocks inside
                     keep their own visibility, so a selection still only shows the parts of this that apply. -->
                <StackPanel x:Name="SelectionBlock" Visibility="Collapsed">
                    <TextBlock Text="PART" Style="{StaticResource SideHeader}"/>
                    <TextBox x:Name="InsFriendly" Style="{StaticResource InlineName}" Text="—" IsReadOnly="True" Focusable="False"
                             PreviewMouseLeftButtonDown="OnPartNamePreviewClick" GotKeyboardFocus="OnPartNameFocused"
                             LostFocus="OnPartNameLostFocus" KeyDown="OnPartNameKeyDown"/>
                    <TextBlock x:Name="InsInternal" Style="{StaticResource SideValue}" Opacity="0.6" FontSize="11"/>
                    <!-- Opening a container was a right-click-only affordance, which is a hard thing to find if
                         nobody tells you it is there. Shown for whatever the PART block is describing, placed part
                         or deck item, whenever that thing can hold something. -->
                    <Button x:Name="BtnContents" Visibility="Collapsed" Margin="0,6,0,0" HorizontalAlignment="Left"
                            Padding="10,3,10,3" FontSize="12" Click="OnContentsClick"
                            ToolTip="Open this container (Enter)"/>
                    <StackPanel x:Name="DescBlock" Visibility="Collapsed">
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource SideHeader}"/>
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="InsDesc" Style="{StaticResource SideValue}" FontSize="12"
                                       TextWrapping="Wrap" Opacity="0.85"/>
                        </ScrollViewer>
                    </StackPanel>
                    <TextBlock Text="CATEGORY" Style="{StaticResource SideHeader}"/>
                    <TextBlock x:Name="InsCategory" Style="{StaticResource SideValue}"/>
                    <TextBlock Text="FOOTPRINT" Style="{StaticResource SideHeader}"/>
                    <TextBlock x:Name="InsSize" Style="{StaticResource SideValue}"/>
                    <StackPanel x:Name="PriceBlock" Visibility="Collapsed">
                        <TextBlock Text="BASE VALUE" Style="{StaticResource SideHeader}"/>
                        <TextBlock x:Name="InsPrice" Style="{StaticResource SideValue}"/>
                    </StackPanel>
                    <!-- Curated key stats (mass, health, work, power…), from the raw game-data cond values. -->
                    <StackPanel x:Name="StatsBlock" Visibility="Collapsed">
                        <TextBlock Text="STATS" Style="{StaticResource SideHeader}"/>
                        <StackPanel x:Name="StatsList"/>
                    </StackPanel>
                    <!-- The device's own control panel: which sensor it follows, and the switches the game's panel
                         offers for it. Only shown for a selected part that actually has one (a pump, scrubber, heater
                         or cooler), and only the modes its def declares. -->
                    <StackPanel x:Name="DeviceBlock" Visibility="Collapsed">
                        <TextBlock Text="DEVICE" Style="{StaticResource SideHeader}"/>
                        <TextBlock x:Name="InsSensor" Style="{StaticResource SideValue}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Bus" Style="{StaticResource SideValue}" FontSize="11" Opacity="0.6"/>
                        <ComboBox x:Name="InsDeviceBus" Margin="0,2,0,4" FontSize="12"
                                  SelectionChanged="OnDeviceBusChanged"/>
                        <CheckBox x:Name="InsDeviceTurbo" Content="Turbo" FontSize="12" Margin="0,2,0,0"
                                  Foreground="{DynamicResource Ink}" Click="OnDeviceModeChanged"/>
                        <CheckBox x:Name="InsDeviceReverse" Content="Reverse" FontSize="12" Margin="0,2,0,0"
                                  Foreground="{DynamicResource Ink}" Click="OnDeviceModeChanged"/>
                        <CheckBox x:Name="InsDeviceSlow" Content="Slow mode" FontSize="12" Margin="0,2,0,0"
                                  Foreground="{DynamicResource Ink}" Click="OnDeviceModeChanged"/>
                    </StackPanel>
                    <!-- A loot spawner's own control panel (#55). What it spawns is the whole of what it is: a
                         spawner with no panel is built from the def's defaults and makes nothing. -->
                    <StackPanel x:Name="SpawnerBlock" Visibility="Collapsed">
                        <TextBlock Text="SPAWNER" Style="{StaticResource SideHeader}"/>
                        <TextBlock Text="Spawns" Style="{StaticResource SideValue}" FontSize="11" Opacity="0.6"/>
                        <ComboBox x:Name="InsSpawnerType" Margin="0,2,0,4" FontSize="12"
                                  SelectionChanged="OnSpawnerTypeChanged"/>
                        <Button x:Name="BtnSpawnerTarget" Margin="0,2,0,2" FontSize="12" Padding="6,3"
                                HorizontalContentAlignment="Left" Click="OnSpawnerTargetClick"/>
                        <TextBlock x:Name="InsSpawnerWarn" Style="{StaticResource SideValue}" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Warn}"
                                   Visibility="Collapsed" Margin="0,2,0,2"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Scatter (tiles)" Style="{StaticResource SideValue}" FontSize="11" Opacity="0.6"/>
                                <TextBox x:Name="InsSpawnerRange" FontSize="12" Margin="0,2,0,0"
                                         LostFocus="OnSpawnerNumberChanged" KeyDown="OnSpawnerNumberKey"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="How many" Style="{StaticResource SideValue}" FontSize="11" Opacity="0.6"/>
                                <TextBox x:Name="InsSpawnerCount" FontSize="12" Margin="0,2,0,0"
                                         LostFocus="OnSpawnerNumberChanged" KeyDown="OnSpawnerNumberKey"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Fires when the ship spawns" Style="{StaticResource SideValue}"
                                   FontSize="11" Opacity="0.6" Margin="0,6,0,0"/>
                        <CheckBox x:Name="InsSpawnerNew" Content="New" FontSize="12" Margin="0,2,0,0"
                                  Foreground="{DynamicResource Ink}" Click="OnSpawnerFlagChanged"/>
                        <CheckBox x:Name="InsSpawnerDamaged" Content="Damaged" FontSize="12" Margin="0,2,0,0"
                                  Foreground="{DynamicResource Ink}" Click="OnSpawnerFlagChanged"/>
                        <CheckBox x:Name="InsSpawnerDerelict" Content="Derelict" FontSize="12" Margin="0,2,0,0"
                                  Foreground="{DynamicResource Ink}" Click="OnSpawnerFlagChanged"/>
                    </StackPanel>
                    <TextBlock Text="SOURCE" Style="{StaticResource SideHeader}"/>
                    <TextBlock x:Name="InsOrigin" Style="{StaticResource SideValue}"/>
                    <TextBlock Text="INSTALL MATERIALS" Style="{StaticResource SideHeader}"/>
                    <TextBlock x:Name="InsInputs" Style="{StaticResource SideValue}" FontSize="12"/>
                </StackPanel>
                <!-- The full raw game data: every numeric cond verbatim, and the part's condition flags. -->
                <Expander x:Name="RawExpander" Visibility="Collapsed" Margin="0,12,0,0"
                          Header="All game data (raw)" Foreground="{DynamicResource Dim}" FontSize="11">
                    <StackPanel x:Name="RawList" Margin="0,4,0,2"/>
                </Expander>
                <Expander x:Name="FlagsExpander" Visibility="Collapsed" Margin="0,4,0,0"
                          Header="Conditions (flags)" Foreground="{DynamicResource Dim}" FontSize="11">
                    <TextBlock x:Name="FlagsList" Style="{StaticResource SideValue}" FontSize="11"
                               TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,2"/>
                </Expander>
              </StackPanel>
            </ScrollViewer>
        </Border>
        </Grid>
    </DockPanel>
</Window>
