<Window x:Class="Ostraplan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ostraplan.App"
        Title="Ostraplan" Width="1440" Height="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        TextElement.Foreground="{DynamicResource Ink}">
    <Window.Resources>
        <Style x:Key="SideHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="SideValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Uniform small buttons for the Zones panel (Add / Properties / delete) -->
        <!-- Compact: it sits on a header row in a narrow panel, so it sizes to its label rather than to the row. -->
        <Style x:Key="ZoneBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <!-- Toolbar group separator -->
        <Style x:Key="ToolSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="7,3"/>
            <Setter Property="Background" Value="{DynamicResource PanelBorder}"/>
        </Style>
        <!-- Toolbar overlay toggle (Zones / Rooms / Power / Light / Wire). A ToggleButton based on the Fluent theme
             style, so inactive it matches the other toolbar buttons exactly and active it wears the theme's own
             checked accent — theme-aware with correct contrast in every state (hover/pressed, light/dark). The
             IsChecked state is driven from the live overlay flags in MainWindow.SyncViewToggles. -->
        <Style x:Key="OverlayToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
        </Style>
        <!-- A document tab. Same reasoning as OverlayToggle above: a ToggleButton on the Fluent chain wearing the
             theme's own checked accent for the active tab, rather than a hard-set background that Fluent's hover
             state would then paint over. IsChecked is driven from the active session in MainWindow.RefreshDocTabs. -->
        <Style x:Key="DocTab" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,3,4"/>
            <Setter Property="MaxWidth" Value="240"/>
        </Style>
        <DataTemplate x:Key="PartTemplate">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Background="#33808080" CornerRadius="3">
                    <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="3"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Friendly}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Favorite toggle. PreviewMouseLeftButtonDown handles it and marks the event handled, so clicking
                     the star pins/unpins without also arming the row's brush. -->
                <TextBlock Grid.Column="2" Text="{Binding FavGlyph}" FontSize="15" Cursor="Hand"
                           VerticalAlignment="Center" Margin="4,0,2,0"
                           PreviewMouseLeftButtonDown="OnFavStarClick"
                           ToolTip="Pin to Favorites">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
                            <Setter Property="Opacity" Value="0.4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Foreground" Value="#FFF2B01E"/>
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Chrome = everything the user can edit with (toolbar, sidebar, canvas). MainWindow.FreezeDoc disables it as
         one switch while an engine reads the live document off-thread; naming it is what makes that possible. -->
    <DockPanel x:Name="Chrome">
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnFileMenu" Content="File ▾" Padding="10,3" Margin="0,0,3,0" Click="OnFileMenuClick"
                            ToolTip="New, Open, Save, Auto-save, Import, Export, and write-back to a save"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <!-- Edit (frequent — kept as direct buttons) -->
                    <Button x:Name="BtnUndo" Content="Undo" Padding="10,3" Margin="0,0,3,0" Click="OnUndoClick"
                            ToolTip="Undo (Ctrl+Z)"/>
                    <Button x:Name="BtnRedo" Content="Redo" Padding="10,3" Margin="0,0,3,0" Click="OnRedoClick"
                            ToolTip="Redo (Ctrl+Y)"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <Button x:Name="BtnDesignMenu" Content="Design ▾" Padding="10,3" Margin="0,0,3,0" Click="OnDesignMenuClick"
                            ToolTip="Ship identity, wall/floor re-skin, snapshot, and the bill of materials"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <!-- Analyse (headline action — kept prominent) -->
                    <Button x:Name="BtnRating" Content="Ship Rating" Padding="10,3" Margin="0,0,3,0" Click="OnShipRatingClick"
                            Background="{DynamicResource AccentBg}" Foreground="{DynamicResource AccentText}"
                            ToolTip="Analyse rooms, airtightness, certification and the Ship Rating for the current design"/>
                    <Button x:Name="BtnDiagnostics" Content="Diagnostics" Padding="10,3" Margin="0,0,3,0" Click="OnDiagnosticsClick"
                            ToolTip="The game's own nav-console checklist: transponder, antenna, reactor, thrusters, power and life support"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <!-- View overlays (promoted from the View menu — the Fluent checked state highlights while active).
                         The keyboard gestures still toggle these; SyncViewToggles keeps IsChecked in step whichever
                         path fires. Click drives the canvas; the code-set IsChecked never re-enters Click. -->
                    <ToggleButton x:Name="BtnZones" Content="Zones" Style="{StaticResource OverlayToggle}" Click="OnZonesToggleClick"
                            ToolTip="Zones overlay (Z): show the crew-assignable zone paint"/>
                    <ToggleButton x:Name="BtnRooms" Content="Rooms" Style="{StaticResource OverlayToggle}" Click="OnRoomsToggleClick"
                            ToolTip="Rooms overlay (C): show the compartments the game would flood-fill"/>
                    <ToggleButton x:Name="BtnPower" Content="Power" Style="{StaticResource OverlayToggle}" Click="OnPowerToggleClick"
                            ToolTip="Power overlay (P): show the conduit network and orphaned runs"/>
                    <ToggleButton x:Name="BtnLight" Content="Light" Style="{StaticResource OverlayToggle}" Click="OnLightToggleClick"
                            ToolTip="Light Viz (L): simulate the in-game interior lighting"/>
                    <ToggleButton x:Name="BtnWalk" Content="Walk" Style="{StaticResource OverlayToggle}" Click="OnWalkToggleClick"
                            ToolTip="Walk overlay (K): show which tiles crew can reach, and which fittings they can operate"/>
                    <ToggleButton x:Name="BtnWire" Content="Wire" Style="{StaticResource OverlayToggle}" Click="OnWireToggleClick"
                            ToolTip="Wire mode: show the signal wiring, and click a device then another to connect them"/>
                    <ToggleButton x:Name="BtnSurface" Content="Surfaces" Style="{StaticResource OverlayToggle}" Click="OnSurfaceToggleClick"
                            ToolTip="Surfaces mode (T): ghost everything but walls and floors, and paint skins straight onto the deck"/>

                    <Border Style="{StaticResource ToolSep}"/>

                    <Button x:Name="BtnViewMenu" Content="View ▾" Padding="10,3" Margin="0,0,3,0" Click="OnViewMenuClick"
                            ToolTip="Fit, symmetry, and the Light Viz / Walk overlay options"/>
                </StackPanel>

                <!-- Right side (added right-to-left) -->
                <Button x:Name="BtnHelp" Content="Help ▾" DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0"
                        Click="OnHelpMenuClick" ToolTip="Controls &amp; keybinds (F1), report a bug, and the activity log"/>
                <Button x:Name="BtnSettings" Content="⚙ Settings" DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0"
                        Click="OnSettingsClick"
                        ToolTip="Theme, UI scale, mod overrides, and the game folders (Ctrl+,)"/>
                <Button x:Name="BtnUpdate" DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0"
                        Visibility="Collapsed" Click="OnUpdateClick"
                        Background="{DynamicResource AccentBg}" Foreground="{DynamicResource AccentText}"
                        ToolTip="A newer release is available — click to open the download page"/>
                <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource Dim}" Margin="12,0,0,0"/>
                <TextBlock x:Name="TxtWarnings" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource Warn}" Margin="12,0,0,0"/>
                <TextBlock x:Name="TxtDoc" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}" Foreground="{DynamicResource Dim}">
            <StatusBarItem><TextBlock x:Name="TxtCell" Text="—" Width="110"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtSel" Text="" Width="90"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtZoom" Text="" Width="90"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtBrush" Text="" Width="80"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtParts" Text=""/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="TxtGhost" Text="" FontWeight="SemiBold" Foreground="{DynamicResource Bad}"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtHint" Opacity="0.7"
                           Text="drag paint · Shift+drag fill · Ctrl+Shift hollow · RMB menu · R rotate · Q/E view · M symmetry · WASD pan · F1 help"/>
            </StatusBarItem>
        </StatusBar>

        <Border DockPanel.Dock="Left" Width="330" Background="{DynamicResource PanelBg}" Padding="8"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBox x:Name="TxtSearch" DockPanel.Dock="Top" Margin="0,0,0,6" Padding="4,3"
                         TextChanged="OnSearchChanged" ToolTip="Search parts by name"/>
                <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Right" Width="270" Background="{DynamicResource PanelBg}" Padding="12,8"
                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,6,0">
                <TextBlock Text="PROBLEMS" Style="{StaticResource SideHeader}" Margin="0,0,0,4"/>
                <StackPanel x:Name="ProblemsPanel"/>
                <Separator Margin="0,10,0,0" Background="{DynamicResource PanelBorder}"/>
                <!-- LastChildFill MUST stay False. It defaults to True, and the button is the last child, so with
                     the default it ignores its Dock and stretches across the whole row: a "+ Add" the width of the
                     panel, jammed against the ZONES caption. -->
                <DockPanel Margin="0,10,0,2" LastChildFill="False">
                    <TextBlock Text="ZONES" DockPanel.Dock="Left" Style="{StaticResource SideHeader}"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAddZone" Content="+ Add" DockPanel.Dock="Right" Style="{StaticResource ZoneBtn}"
                            Click="OnAddZoneClick" ToolTip="Create a zone and start painting its tiles"/>
                </DockPanel>
                <StackPanel x:Name="ZonesPanel"/>
                <Separator Margin="0,10,0,0" Background="{DynamicResource PanelBorder}"/>
                <TextBlock Text="PART" Style="{StaticResource SideHeader}"/>
                <TextBlock x:Name="InsFriendly" Style="{StaticResource SideValue}" FontSize="15" FontWeight="SemiBold" Text="—"/>
                <TextBlock x:Name="InsInternal" Style="{StaticResource SideValue}" Opacity="0.6" FontSize="11"/>
                <StackPanel x:Name="DescBlock" Visibility="Collapsed">
                    <TextBlock Text="DESCRIPTION" Style="{StaticResource SideHeader}"/>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="InsDesc" Style="{StaticResource SideValue}" FontSize="12"
                                   TextWrapping="Wrap" Opacity="0.85"/>
                    </ScrollViewer>
                </StackPanel>
                <TextBlock Text="CATEGORY" Style="{StaticResource SideHeader}"/>
                <TextBlock x:Name="InsCategory" Style="{StaticResource SideValue}"/>
                <TextBlock Text="FOOTPRINT" Style="{StaticResource SideHeader}"/>
                <TextBlock x:Name="InsSize" Style="{StaticResource SideValue}"/>
                <StackPanel x:Name="PriceBlock" Visibility="Collapsed">
                    <TextBlock Text="BASE VALUE" Style="{StaticResource SideHeader}"/>
                    <TextBlock x:Name="InsPrice" Style="{StaticResource SideValue}"/>
                </StackPanel>
                <!-- Curated key stats (mass, health, work, power…), from the raw game-data cond values. -->
                <StackPanel x:Name="StatsBlock" Visibility="Collapsed">
                    <TextBlock Text="STATS" Style="{StaticResource SideHeader}"/>
                    <StackPanel x:Name="StatsList"/>
                </StackPanel>
                <TextBlock Text="SOURCE" Style="{StaticResource SideHeader}"/>
                <TextBlock x:Name="InsOrigin" Style="{StaticResource SideValue}"/>
                <TextBlock Text="INSTALL MATERIALS" Style="{StaticResource SideHeader}"/>
                <TextBlock x:Name="InsInputs" Style="{StaticResource SideValue}" FontSize="12"/>
                <!-- The full raw game data: every numeric cond verbatim, and the part's condition flags. -->
                <Expander x:Name="RawExpander" Visibility="Collapsed" Margin="0,12,0,0"
                          Header="All game data (raw)" Foreground="{DynamicResource Dim}" FontSize="11">
                    <StackPanel x:Name="RawList" Margin="0,4,0,2"/>
                </Expander>
                <Expander x:Name="FlagsExpander" Visibility="Collapsed" Margin="0,4,0,0"
                          Header="Conditions (flags)" Foreground="{DynamicResource Dim}" FontSize="11">
                    <TextBlock x:Name="FlagsList" Style="{StaticResource SideValue}" FontSize="11"
                               TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,2"/>
                </Expander>
              </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <!-- The document tab strip. Auto, and collapsed while one design is open, so a single-document
                     session looks exactly as it did before tabs existed. -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="DocTabBar" Grid.Row="0" Visibility="Collapsed" Padding="6,4,6,0"
                    Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DocTabStrip" Orientation="Horizontal"/>
                </ScrollViewer>
            </Border>

            <!-- Every open design's canvas lives here at once. The active one is Visible and the rest Hidden, not
                 Collapsed: Hidden is still measured and arranged, so a background tab keeps a real size and its
                 zoom, pan and framing stay meaningful, while WPF skips drawing it entirely. -->
            <Grid x:Name="CanvasHost" Grid.Row="1"/>

            <!-- The Surfaces bar: the two brushes a pattern alternates between, and the pattern itself. Shown only
                 while Surfaces mode is on (MainWindow.UpdateSurfaceBar drives every part of it). Slot A is the armed
                 palette brush; slot B is picked by arming the slot, then clicking a palette part. -->
            <Border x:Name="SurfaceBar" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="14,10,0,0" Padding="10,8" CornerRadius="6"
                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="SURFACES" Foreground="{DynamicResource Dim}" FontSize="11" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton x:Name="SlotA" Padding="6,3" Margin="0,0,4,0" Click="OnSurfaceSlotClick"
                                      ToolTip="The main brush — arm it from the palette">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgSlotA" Width="22" Height="22" Stretch="Uniform" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="TxtSlotA" Text="A: none" VerticalAlignment="Center" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="SlotB" Padding="6,3" Margin="0,0,4,0" Click="OnSurfaceSlotClick"
                                      ToolTip="The second brush of a pattern — click this, then pick a matching wall or floor from the palette">
                            <StackPanel Orientation="Horizontal">
                                <Image x:Name="ImgSlotB" Width="22" Height="22" Stretch="Uniform" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="TxtSlotB" Text="B: none" VerticalAlignment="Center" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button x:Name="BtnClearSlotB" Content="✕" Padding="7,3" Click="OnClearSlotBClick"
                                ToolTip="Clear the second brush"/>
                    </StackPanel>
                    <StackPanel x:Name="PatternRow" Orientation="Horizontal" Margin="0,6,0,0">
                        <ToggleButton x:Name="PatSolid" Content="Solid" Tag="Solid" Padding="9,3" Margin="0,0,4,0"
                                      Click="OnSurfacePatternClick" ToolTip="One brush on every tile"/>
                        <ToggleButton x:Name="PatChecker" Content="Checker" Tag="Checker" Padding="9,3" Margin="0,0,4,0"
                                      Click="OnSurfacePatternClick" ToolTip="Alternate the two brushes like a chequerboard"/>
                        <ToggleButton x:Name="PatRows" Content="Rows" Tag="StripesH" Padding="9,3" Margin="0,0,4,0"
                                      Click="OnSurfacePatternClick" ToolTip="Alternate the two brushes row by row"/>
                        <ToggleButton x:Name="PatCols" Content="Columns" Tag="StripesV" Padding="9,3"
                                      Click="OnSurfacePatternClick" ToolTip="Alternate the two brushes column by column"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="SHOW" Foreground="{DynamicResource Dim}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ToggleButton x:Name="FocusBoth" Content="Both" Tag="Both" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceFocusClick" ToolTip="Walls and floors both bright"/>
                        <ToggleButton x:Name="FocusFloors" Content="Floors" Tag="Floors" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceFocusClick"
                                      ToolTip="Ghost the walls too, so the floors under them can be seen and clicked"/>
                        <ToggleButton x:Name="FocusWalls" Content="Walls" Tag="Walls" Padding="8,3" Margin="0,0,12,0"
                                      Click="OnSurfaceFocusClick" ToolTip="Ghost the floors, so a wall run reads on its own"/>
                        <TextBlock Text="PAINT" Foreground="{DynamicResource Dim}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ToggleButton x:Name="ModeReplace" Content="Replace" Tag="Replace" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceModeButtonClick"
                                      ToolTip="Only re-skin what is already there — a stroke past the edge of a room adds nothing"/>
                        <ToggleButton x:Name="ModeBoth" Content="Both" Tag="ReplaceAndFill" Padding="8,3" Margin="0,0,3,0"
                                      Click="OnSurfaceModeButtonClick" ToolTip="Re-skin what is there, and lay a new one on a bare tile"/>
                        <ToggleButton x:Name="ModeFill" Content="Fill" Tag="Fill" Padding="8,3"
                                      Click="OnSurfaceModeButtonClick" ToolTip="Only lay on bare tiles, never change what is there"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtSurfaceNote" Foreground="{DynamicResource Dim}" FontSize="11" Margin="0,6,0,0"
                               MaxWidth="420" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0">
                <Border x:Name="BadgeWarning" Background="#F0E0A34E" CornerRadius="14" Height="28" MinWidth="28"
                        Visibility="Collapsed" Margin="8,0,0,0">
                    <TextBlock x:Name="BadgeWarningText" Foreground="#FF23262C" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0"/>
                </Border>
                <Border x:Name="BadgeBlocking" Background="#F0D64545" CornerRadius="14" Height="28" MinWidth="28"
                        Visibility="Collapsed" Margin="8,0,0,0">
                    <TextBlock x:Name="BadgeBlockingText" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="9,0"/>
                </Border>
            </StackPanel>
            <!-- Over the tab strip as well as the canvas: while game data is loading there is nothing to switch to. -->
            <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#DD1A1C20">
                <TextBlock x:Name="TxtLoading" Text="Locating Ostranauts…" Foreground="#FFD8DDE4"
                           FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
