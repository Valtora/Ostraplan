<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Ostraplan</AssemblyName>
    <RootNamespace>Ostraplan.App</RootNamespace>
    <Version>1.37.2</Version>
    <UseWPF>true</UseWPF>
    <!-- Explicit entry point (Program.Main) so Velopack's install/update/uninstall hooks
         run before any WPF init. App.xaml is compiled as a Page, not the default
         ApplicationDefinition, so the SDK does not also generate a Main, which would clash
         with ours; InitializeComponent is still generated for the App partial class.

         This has to be a property, not an ApplicationDefinition Remove plus Page Include.
         WPF's markup compile builds a temporary copy of this project (*_wpftmp.csproj, next
         to this file) that keeps the property groups but drops those items. A design-time
         build that loads the copy (the C# Dev Kit does, from the workspace) then compiled
         App.xaml as the ApplicationDefinition into the same obj folder mid-build, so
         App.g.cs lost InitializeComponent and App.baml vanished: the intermittent
         "error BG1002: App.baml cannot be found" and CS1061. With the property off, the
         SDK's own *.xaml glob makes App.xaml a Page in both projects. -->
    <StartupObject>Ostraplan.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ostraplan.Core\Ostraplan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer + auto-updater (see VeloUpdate.cs, publish.ps1). Same version as Ostrasort. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ostraplan.Tests" />
  </ItemGroup>

  <!-- The changelog ships inside the build, so "what's new" after an update describes the copy that is
       actually running and needs no network call (see ReleaseNotes / WhatsNewUI). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Ostraplan.CHANGELOG.md" />
  </ItemGroup>

</Project>
